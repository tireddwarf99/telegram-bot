# Telegram Bot Token (основной)
TELEGRAM_API=your_telegram_bot_token_here

# Telegram Bot Token (тестовый, опционально)
TELEGRAM_API_TEST=your_test_bot_token_here

# Telegram ID администратора
TELEGRAM_ID_ADM=your_telegram_user_id_here

# RapidAPI ключ (для Instagram)
RAPID_API_KEY=your_rapidapi_key_here
RAPID_API_HOST=instagram-looter2.p.rapidapi.com

# RapidAPI ключ (для YouTube, если используется)
RAPID_API_KEY_YOUTUBE=your_rapidapi_key_here
RAPID_API_HOST_YOUTUBE=yt-api.p.rapidapi.com
